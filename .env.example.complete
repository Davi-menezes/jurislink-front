# 🔐 JurisLink - Variáveis de Ambiente Completas

# ==========================================
# SUPABASE (OBRIGATÓRIO)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui
# Compatibilidade com código legado:
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-publishable-key-aqui
SUPABASE_SECRET_KEY=sua-secret-key-aqui
# Compatibilidade com código legado:
SUPABASE_SERVICE_ROLE_KEY=sua-secret-key-aqui

# ==========================================
# GOOGLE OAUTH (SEM OAUTH NO SUPABASE)
# ==========================================
GOOGLE_OAUTH_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu-google-client-secret-aqui

# ==========================================
# UPSTASH REDIS (OBRIGATÓRIO)
# ==========================================
KV_REST_API_URL=https://seu-redis.upstash.io
KV_REST_API_TOKEN=seu-token-redis

# ==========================================
# MERCADO PAGO (OBRIGATÓRIO PARA PAGAMENTOS)
# ==========================================
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-123
MERCADO_PAGO_SANDBOX=true

# ==========================================
# APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ==========================================
# VERCEL BLOB STORAGE
# ==========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ==========================================
# SECURITY (OBRIGATÓRIO)
# ==========================================
JWT_SECRET=gere-um-secret-super-seguro-de-no-minimo-32-caracteres-aqui
ENCRYPTION_KEY=chave-de-exatos-32-caracteres!!

# ==========================================
# EMAIL (OPCIONAL)
# ==========================================
RESEND_API_KEY=re_sua_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_sua_api_key
SMTP_FROM=noreply@jurislink.com.br

# ==========================================
# ADMIN
# ==========================================
ADMIN_EMAIL=admin@jurislink.com.br

# ==========================================
# NODE ENVIRONMENT
# ==========================================
NODE_ENV=development
